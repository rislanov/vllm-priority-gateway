        {
          "datasource": {
            "type": "prometheus",
            "uid": "llmgw-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (model, le) (rate(llmgw_request_duration_seconds_bucket{model=~\"$model\",priority_class=\"high\",status_class=\"2xx\"}[$__rate_interval])))",
          "legendFormat": "{{model}} · request p95",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "llmgw-prometheus"
