{
  "annotations": {
    "list": []
  },
  "description": "Gateway-owned admission and routing decisions. Read the first row left to right: GPU pressure, Low rejections, High latency, then High gateway queue wait.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "llmgw-prometheus"
      },
      "description": "Best eligible backend pressure used by pool admission. Threshold colors align the overload progression on the same timeline as the next three panels.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "pressure",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 18,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 3,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.55
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "red",
                "value": 1.2
              },
              {
                "color": "dark-red",
                "value": 1.5
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "llmgw-prometheus"
          },
          "editorMode": "code",
          "expr": "max by (model) (llmgw_pool_pressure{model=~\"$model\"})",
          "legendFormat": "{{model}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "1 · GPU pool pressure rises",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "llmgw-prometheus"
      },
      "description": "Gateway-owned Low (background) rejection decisions per second, split by the precise bounded reason.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "429 decisions/s",
            "axisPlacement": "auto",
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1,
            "pointSize": 3,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "llmgw-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (model, reason) (rate(llmgw_requests_rejected_total{model=~\"$model\",priority_class=\"background\",reason=~\"pool_waiting_limit|pool_inflight_limit|priority_concurrency_limit\"}[$__rate_interval]))",
          "legendFormat": "{{model}} · {{reason}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "2 · Low receives 429 decisions",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "llmgw-prometheus"
      },
