# Copy this file to .env and replace both blank secrets before starting Compose.
LLMGW_VERSION=0.1.0
LLMGW_ADMIN_USERNAME=operator
LLMGW_ADMIN_PASSWORD=
LLMGW_API_KEY_HMAC_SECRET=
LLMGW_PORT=8080

# Optional compose.observability.yaml ports and local-only Grafana credentials.
LLMGW_PROMETHEUS_PORT=9090
LLMGW_GRAFANA_PORT=3000
LLMGW_GRAFANA_ADMIN_USER=admin
LLMGW_GRAFANA_ADMIN_PASSWORD=admin

# The tested two-node Qwen configuration fits a 12 GiB NVIDIA GPU.
VLLM_IMAGE=vllm/vllm-openai:v0.28.0
VLLM_MODEL=Qwen/Qwen3-0.6B
VLLM_SERVED_MODEL=qwen-test
VLLM_GPU_MEMORY_UTILIZATION=0.32
VLLM_MAX_MODEL_LEN=1024
VLLM_MAX_NUM_SEQS=1
VLLM_SHM_SIZE=4gb
HF_TOKEN=

# The compatibility runner is deterministic across Linux Docker Engine and Docker Desktop.
VLLM_USE_V2_MODEL_RUNNER=0
